@"
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="NexusQA Regression Suite" verbose="1" parallel="methods" thread-count="3">
    <listeners>
        <listener class-name="com.akash.nexusqa.listeners.TestListener"/>
    </listeners>
    <test name="Regression Tests">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="com.akash.nexusqa.tests.ui.LoginTest"/>
        </classes>
    </test>
</suite>
"@ | Set-Content -Path src\test\resources\suites\regression.xml -Encoding UTF8